# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: sends the demo requests from the site's popup by email (api/request-demo.ts) and the waitlist's
# confirmation emails (api/join-waitlist.ts). From resend.com.
# Without it, `npm run dev` prints the emails in the terminal instead, and the live site shows an email fallback.
# RESEND_API_KEY="re_..."

# Optional. Inbox for the requests and the sender (tryspottr.app is verified in Resend). Defaults:
# DEMO_REQUEST_TO="info@tryspottr.app"
# DEMO_REQUEST_FROM="Spottr <demo@tryspottr.app>"

# DATABASE_URL: stores the members' waitlist (api/join-waitlist.ts) in Postgres at Neon. On Vercel, the Neon
# integration sets it. Locally, use the connection string of the Neon `dev` branch, never production's.
# Without it, `npm run dev` prints sign-ups in the terminal instead, and the live site shows an email fallback.
# Tables: db/waitlist.sql, run once per Neon branch.
# DATABASE_URL="postgresql://..."
