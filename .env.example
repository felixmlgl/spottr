# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: sends the demo requests from the site's popup by email (api/request-demo.ts). From resend.com.
# Without it, `npm run dev` prints the email in the terminal instead, and the live site shows an email fallback.
# RESEND_API_KEY="re_..."

# Optional. Inbox for the requests (default info@tryspottr.app) and the sender. The default sender
# (onboarding@resend.dev) only delivers to the Resend account's own email; verify tryspottr.app in Resend to send from it.
# DEMO_REQUEST_TO="info@tryspottr.app"
# DEMO_REQUEST_FROM="Spottr <demo@tryspottr.app>"
